// prisma/schema.prisma — ArtisaStock V2
// Auteur : Agent #4 — Backend Developer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

enum Plan {
  FREE_TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum OrderStatus {
  NEW
  CONFIRMED
  STOCK_CONFLICT
  IN_PREPARATION
  READY
  PICKED_UP
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum VatRate {
  FOOD_6
  STANDARD_21
}

enum UnitOfMeasure {
  KG
  G
  MG
  CG
  L
  DL
  CL
  ML
  PIECE
  DOZEN
}

enum BomInputType {
  INGREDIENT
  SHEET
}

enum PhysicalType {
  SOLID
  LIQUID
  POWDER
  PIECE
}

enum BomSourceType {
  LOT_INGREDIENT
  BOM_STOCK
}

enum StockChannel {
  VITRINE
  DIRECT
}

enum ClosureReason {
  WASTE
  STAFF
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BlockType {
  HERO
  TEXT
  IMAGE
  GALLERY
  PRODUCTS
  CONTACT
  TESTIMONIALS
  MAP
  CUSTOM_HTML
}

enum NotificationType {
  ORDER_NEW
  ORDER_READY
  STOCK_ALERT
  REGISTRATION
  PASSWORD_RESET
  INVOICE_GENERATED
}

enum GdprRequestType {
  ACCESS
  DELETION
}

enum GdprRequestStatus {
  PENDING
  PROCESSED
  REJECTED
}

// ═══════════════════════════════════════════════
// TENANT & AUTH
// ═══════════════════════════════════════════════

model Tenant {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  plan         Plan      @default(FREE_TRIAL)
  locale       String    @default("fr")
  vatNumber    String?
  address      Json?
  phone        String?
  email        String?
  description  String?
  openingHours Json?
  settings     Json      @default("{}")
  trialEndsAt  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users               User[]
  roles               Role[]
  ingredients         Ingredient[]
  suppliers           Supplier[]
  recipes             Recipe[]
  products            Product[]
  orders              Order[]
  customers           Customer[]
  invoices            Invoice[]
  pages               Page[]
  siteConfig          SiteConfig?
  pickupSlots         PickupSlot[]
  closedDays          ClosedDay[]
  notifications       NotificationLog[]
  gdprRequests        GdprRequest[]
  bomContexts         BomContext[]
  bomProductions      BomProduction[]
  bomStocks           BomStock[]
  activites           Activite[]
  stocks              Stock[]
  lots                Lot[]
  tenantVatRates      TenantVatRate[]
  productChannelStock ProductChannelStock[]
  stockClosures       StockClosure[]
  vendeurs            Vendeur[]
  sessionsCaisse      SessionCaisse[]
  pointagesHoraire    PointageHoraire[]
  posSales            PosSale[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  passwordHash    String
  firstName       String
  lastName        String
  locale          String    @default("fr")
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  onboardingDone  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role?            @relation(fields: [roleId], references: [id])
  roleId        String?
  sessions      Session[]
  invitations   UserInvitation[] @relation("InvitedBy")
  stockClosures StockClosure[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

model UserInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  roleId      String?
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// ═══════════════════════════════════════════════
// RBAC
// ═══════════════════════════════════════════════

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  permissions Json // Array de strings : ["ingredients.read", ...]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════
// ERP — INGREDIENTS & STOCK
// ═══════════════════════════════════════════════

model Ingredient {
  id               String        @id @default(cuid())
  tenantId         String
  name             String
  category         String?
  unit             UnitOfMeasure
  physicalType     PhysicalType  @default(PIECE)
  density          Decimal?      @db.Decimal(6, 4) // obligatoire si physicalType = LIQUID | POWDER (validé en Zod)
  packagingLabel   String?
  priceUnit        Decimal       @db.Decimal(10, 4)
  pricePack        Decimal?      @db.Decimal(10, 4)
  packSize         Decimal?      @db.Decimal(10, 4)
  unitsPerLot      Int           @default(1)
  // Dénormalisation intentionnelle : stock = somme des Lot.quantityAvailable, maintenue
  // transactionnellement à chaque création/édition/suppression de lot et à chaque consommation
  // FIFO en production — jamais modifiable directement (pas de PATCH stock générique).
  stock            Decimal       @default(0) @db.Decimal(10, 4)
  alertThreshold   Decimal       @default(0) @db.Decimal(10, 4)
  isAlertActive    Boolean       @default(true)
  dlcDaysReference Int?
  qualityLabel     String?
  defaultStockId   String?
  supplierId       String?
  supplierRef      String?
  notes            String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  defaultStock      Stock?             @relation("IngredientDefaultStock", fields: [defaultStockId], references: [id])
  recipeIngredients RecipeIngredient[]
  bomLines          BomLine[]
  lots              Lot[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@index([supplierId])
  @@index([defaultStockId])
}

// ═══════════════════════════════════════════════
// LOTS — instances d'achat (traçabilité, FIFO)
// ═══════════════════════════════════════════════

model Lot {
  id                String    @id @default(cuid())
  tenantId          String
  ingredientId      String
  stockId           String
  supplierId        String?
  lotNumber         String?
  purchaseDate      DateTime  @default(now())
  expiryDate        DateTime?
  quantityInitial   Decimal   @db.Decimal(12, 4)
  quantityAvailable Decimal   @db.Decimal(12, 4)
  unitPrice         Decimal   @db.Decimal(10, 4) // HTVA par conditionnement — toujours stocké HTVA
  totalPriceHT      Decimal   @db.Decimal(10, 2)
  vatRate           VatRate   @default(STANDARD_21)
  invoiceRef        String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  stock      Stock      @relation(fields: [stockId], references: [id], onDelete: Restrict)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])

  @@index([tenantId])
  @@index([ingredientId, purchaseDate])
  @@index([stockId])
}

// ═══════════════════════════════════════════════
// ERP — FOURNISSEURS
// ═══════════════════════════════════════════════

model Supplier {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  address     Json?
  phone       String?
  email       String?
  website     String?
  vatNumber   String?
  contactName String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  lots        Lot[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ═══════════════════════════════════════════════
// ERP — RECETTES & FICHES TECHNIQUES
// ═══════════════════════════════════════════════

model Recipe {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  category       String?
  imageUrl       String?
  servings       Int       @default(1)
  prepTime       Int?
  cookTime       Int?
  steps          Json      @default("[]")
  costPerServing Decimal?  @db.Decimal(10, 4)
  totalCost      Decimal?  @db.Decimal(10, 4)
  marginCoeff    Decimal   @default(2.5) @db.Decimal(5, 2)
  vatRate        VatRate   @default(FOOD_6)
  version        Int       @default(1)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  product     Product?           @relation(fields: [productId], references: [id])
  versions    RecipeVersion[]
  productId   String?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
}

model RecipeIngredient {
  id           String        @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal       @db.Decimal(10, 4)
  unit         UnitOfMeasure

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeVersion {
  id             String   @id @default(cuid())
  recipeId       String
  version        Int
  name           String
  ingredients    Json
  steps          Json
  servings       Int
  totalCost      Decimal? @db.Decimal(10, 4)
  costPerServing Decimal? @db.Decimal(10, 4)
  createdAt      DateTime @default(now())
  createdById    String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
  @@index([recipeId])
}

// ═══════════════════════════════════════════════
// ERP — PRODUITS FINIS
// ═══════════════════════════════════════════════

model Product {
  id                 String    @id @default(cuid())
  tenantId           String
  bomSheetId         String
  name               String
  slug               String
  description        String?
  descriptionLong    String?
  category           String?
  images             Json      @default("[]")
  priceHT            Decimal   @db.Decimal(10, 2)
  priceTTC           Decimal   @db.Decimal(10, 2)
  vatRateId          String
  marginTargetFactor Decimal?  @db.Decimal(5, 2)
  isPerishable       Boolean   @default(false)
  allergens          Json      @default("[]")
  isVisible          Boolean   @default(true)
  isClickCollect     Boolean   @default(true)
  sortOrder          Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomSheet     BomSheet              @relation(fields: [bomSheetId], references: [id], onDelete: Restrict)
  vatRate      TenantVatRate         @relation(fields: [vatRateId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  posSaleItems PosSaleItem[]
  channelStock ProductChannelStock[]
  Recipe       Recipe[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isVisible, isActive])
  @@index([bomSheetId])
  @@index([vatRateId])
}

model TenantVatRate {
  id          String   @id @default(cuid())
  tenantId    String
  label       String
  ratePercent Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model ProductChannelStock {
  id           String       @id @default(cuid())
  tenantId     String
  productId    String
  bomStockId   String
  channel      StockChannel
  qtyAllocated Decimal      @db.Decimal(12, 4)
  qtyRemaining Decimal      @db.Decimal(12, 4)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  bomStock BomStock       @relation(fields: [bomStockId], references: [id], onDelete: Restrict)
  closures StockClosure[]

  @@index([tenantId])
  @@index([productId, channel])
  @@index([bomStockId])
}

model StockClosure {
  id                    String        @id @default(cuid())
  tenantId              String
  productChannelStockId String
  qty                   Decimal       @db.Decimal(12, 4)
  reason                ClosureReason
  note                  String?
  closedByUserId        String
  closedAt              DateTime      @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productChannelStock ProductChannelStock @relation(fields: [productChannelStockId], references: [id], onDelete: Restrict)
  closedByUser        User                @relation(fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([productChannelStockId])
}

// ═══════════════════════════════════════════════
// ERP — COMMANDES
// ═══════════════════════════════════════════════

model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  email         String
  firstName     String
  lastName      String
  phone         String?
  locale        String    @default("fr")
  gdprConsent   Boolean   @default(false)
  gdprConsentAt DateTime?
  isAnonymized  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  orderNumber     String
  customerId      String
  status          OrderStatus @default(NEW)
  totalHT         Decimal     @db.Decimal(10, 2)
  totalTVA        Decimal     @db.Decimal(10, 2)
  totalTTC        Decimal     @db.Decimal(10, 2)
  pickupSlotStart DateTime
  pickupSlotEnd   DateTime
  pickupDate      DateTime
  stripeSessionId String?
  stripePaymentId String?
  paidAt          DateTime?
  trackingToken   String      @unique @default(cuid())
  notes           String?
  statusHistory   Json        @default("[]")
  cgvAcceptedAt   DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  invoice  Invoice?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([trackingToken])
  @@index([stripeSessionId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  vatRatePercent Decimal @db.Decimal(5, 2)
  totalHT        Decimal @db.Decimal(10, 2)
  totalTTC       Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

// ═══════════════════════════════════════════════
// ERP — FACTURATION
// ═══════════════════════════════════════════════

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String        @unique
  invoiceNumber  String
  status         InvoiceStatus @default(ISSUED)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  sellerName     String
  sellerAddress  Json
  sellerVat      String
  buyerName      String
  buyerEmail     String
  buyerAddress   Json?
  totalHT        Decimal       @db.Decimal(10, 2)
  totalTVA       Decimal       @db.Decimal(10, 2)
  totalTTC       Decimal       @db.Decimal(10, 2)
  vatBreakdown   Json
  lines          Json
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  notes          String?
  paymentTerms   String?       @default("Payée par carte bancaire")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, issuedAt])
  @@index([tenantId, status])
}

// ═══════════════════════════════════════════════
// ERP — CRENEAUX DE RETRAIT
// ═══════════════════════════════════════════════

model PickupSlot {
  id              String    @id @default(cuid())
  tenantId        String
  dayOfWeek       DayOfWeek
  startTime       String
  endTime         String
  slotDuration    Int       @default(30)
  maxOrders       Int       @default(5)
  minAdvanceHours Int       @default(24)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, dayOfWeek, isActive])
}

model ClosedDay {
  id       String   @id @default(cuid())
  tenantId String
  date     DateTime @db.Date
  reason   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════
// CMS — PAGES & BLOCS
// ═══════════════════════════════════════════════

model Page {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  slug            String
  metaDescription String?
  ogImage         String?
  blocks          Json      @default("[]")
  sortOrder       Int       @default(0)
  isVisible       Boolean   @default(true)
  isSystem        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isVisible])
}

model SiteConfig {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  template    String    @default("boulangerie")
  logo        String?
  favicon     String?
  colors      Json      @default("{}")
  fonts       Json      @default("{}")
  socialLinks Json      @default("{}")
  customCss   String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════
// NOTIFICATIONS & LOGS
// ═══════════════════════════════════════════════

model NotificationLog {
  id             String           @id @default(cuid())
  tenantId       String
  type           NotificationType
  recipientEmail String
  subject        String
  status         String           @default("sent")
  metadata       Json?
  sentAt         DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([sentAt])
}

model CookieConsent {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String
  necessary   Boolean  @default(true)
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([tenantId])
  @@index([sessionId])
}

model GdprRequest {
  id          String            @id @default(cuid())
  tenantId    String
  customerId  String?
  email       String
  type        GdprRequestType
  status      GdprRequestStatus @default(PENDING)
  processedAt DateTime?
  processedBy String?
  notes       String?
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

// ═══════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entity])
  @@index([tenantId, userId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════
// BOM — NOMENCLATURE DE FABRICATION
// ═══════════════════════════════════════════════

model BomContext {
  id          String   @id @default(cuid())
  tenantId    String
  activiteId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activite Activite   @relation(fields: [activiteId], references: [id], onDelete: Restrict)
  levels   BomLevel[]

  @@unique([activiteId, name])
  @@index([tenantId])
  @@index([activiteId])
}

model BomLevel {
  id          String   @id @default(cuid())
  contextId   String
  order       Int // commence à 1, aucun niveau protégé par son rang — seul le niveau d'ordre max est supprimable
  name        String
  description String?
  createdAt   DateTime @default(now())

  context     BomContext      @relation(fields: [contextId], references: [id], onDelete: Cascade)
  sheets      BomSheet[]
  productions BomProduction[]

  @@unique([contextId, order])
  @@index([contextId])
}

model BomSheet {
  id          String        @id @default(cuid())
  levelId     String
  name        String
  description String?
  outputUnit  UnitOfMeasure
  outputQty   Decimal       @db.Decimal(10, 4)
  prepTime    Int?
  targetStock Decimal?      @db.Decimal(10, 4)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  level        BomLevel        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lines        BomLine[]
  productions  BomProduction[]
  stocks       BomStock[]
  asInputLines BomLine[]       @relation("SubSheet")
  products     Product[]

  @@unique([levelId, name])
  @@index([levelId])
}

model BomLine {
  id           String        @id @default(cuid())
  sheetId      String
  inputType    BomInputType
  ingredientId String?
  subSheetId   String?
  quantity     Decimal       @db.Decimal(12, 4)
  unit         UnitOfMeasure

  sheet      BomSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subSheet   BomSheet?   @relation("SubSheet", fields: [subSheetId], references: [id], onDelete: Restrict)

  @@index([sheetId])
  @@index([ingredientId])
  @@index([subSheetId])
}

model BomProduction {
  id              String   @id @default(cuid())
  tenantId        String
  levelId         String
  sheetId         String
  nBatches        Decimal  @db.Decimal(10, 4)
  outputQty       Decimal  @db.Decimal(10, 4)
  ingredientsCost Decimal  @default(0) @db.Decimal(10, 2)
  unitCost        Decimal  @default(0) @db.Decimal(10, 4)
  notes           String?
  producedAt      DateTime @default(now())

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level  BomLevel            @relation(fields: [levelId], references: [id], onDelete: Restrict)
  sheet  BomSheet            @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  lines  BomProductionLine[]
  stocks BomStock[]

  @@index([tenantId])
  @@index([sheetId])
  @@index([tenantId, producedAt])
}

model BomProductionLine {
  id             String        @id @default(cuid())
  productionId   String
  sourceType     BomSourceType
  ingredientId   String?
  lotId          String? // lot précis consommé (traçabilité FIFO) — une ligne par lot touché
  bomStockId     String?
  qtyConsumed    Decimal       @db.Decimal(12, 4)
  unitCostAtTime Decimal       @db.Decimal(10, 4)

  production BomProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([productionId])
}

model BomStock {
  id           String    @id @default(cuid())
  tenantId     String
  sheetId      String
  productionId String
  qtyAvailable Decimal   @db.Decimal(12, 4)
  unitCost     Decimal   @db.Decimal(10, 4)
  producedAt   DateTime
  dlcDate      DateTime?
  createdAt    DateTime  @default(now())

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sheet              BomSheet              @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  production         BomProduction         @relation(fields: [productionId], references: [id], onDelete: Restrict)
  channelAllocations ProductChannelStock[]

  @@index([tenantId, sheetId, qtyAvailable, producedAt])
}

// ═══════════════════════════════════════════════
// ACTIVITÉS & STOCKS (emplacements physiques)
// ═══════════════════════════════════════════════

model Activite {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks      ActiviteStock[]
  bomContexts BomContext[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Stock {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activites             ActiviteStock[]
  lots                  Lot[]
  defaultForIngredients Ingredient[]    @relation("IngredientDefaultStock")

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Jonction M:N — un stock (emplacement physique) peut être partagé entre plusieurs activités
model ActiviteStock {
  activiteId String
  stockId    String
  createdAt  DateTime @default(now())

  activite Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  stock    Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@id([activiteId, stockId])
  @@index([stockId])
}

// ═══════════════════════════════════════════════
// POS (Point de Vente) — docs/modules/POS.md
// ═══════════════════════════════════════════════
// Vend depuis ProductChannelStock canal DIRECT (déjà alloué depuis Boutique/Produits
// étape 7, jamais consommé jusqu'ici) — voir src/lib/products/channel-stock.ts.
// Identité Vendeur distincte de User : auth PIN comptoir, jamais le JWT admin.

enum SessionCaisseStatus {
  OPEN
  CLOSED
}

enum PosPaymentMethod {
  CASH
  CARD
}

model Vendeur {
  id                String    @id @default(cuid())
  tenantId          String
  firstName         String
  lastName          String
  pinHash           String
  isActive          Boolean   @default(true)
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionsCaisse SessionCaisse[]
  pointages      PointageHoraire[]
  posSales       PosSale[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model SessionCaisse {
  id           String              @id @default(cuid())
  tenantId     String
  vendeurId    String
  openingFloat Decimal             @db.Decimal(10, 2)
  closingFloat Decimal?            @db.Decimal(10, 2)
  variance     Decimal?            @db.Decimal(10, 2)
  status       SessionCaisseStatus @default(OPEN)
  openedAt     DateTime            @default(now())
  closedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendeur  Vendeur   @relation(fields: [vendeurId], references: [id], onDelete: Restrict)
  posSales PosSale[]

  @@index([tenantId])
  @@index([vendeurId])
  @@index([tenantId, status])
}

model PointageHoraire {
  id        String    @id @default(cuid())
  tenantId  String
  vendeurId String
  clockIn   DateTime  @default(now())
  clockOut  DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendeur Vendeur @relation(fields: [vendeurId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendeurId])
}

// Métadonnées de ticket uniquement — la vérité du stock reste ProductChannelStock,
// jamais dupliquée ici (contrairement à Order, pas de client/créneau obligatoire).
model PosSale {
  id              String           @id @default(cuid())
  tenantId        String
  vendeurId       String
  sessionCaisseId String
  paymentMethod   PosPaymentMethod
  totalTTC        Decimal          @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendeur       Vendeur       @relation(fields: [vendeurId], references: [id], onDelete: Restrict)
  sessionCaisse SessionCaisse @relation(fields: [sessionCaisseId], references: [id], onDelete: Restrict)
  items         PosSaleItem[]

  @@index([tenantId])
  @@index([sessionCaisseId])
  @@index([tenantId, createdAt])
}

model PosSaleItem {
  id           String  @id @default(cuid())
  posSaleId    String
  productId    String
  quantity     Int
  unitPriceTTC Decimal @db.Decimal(10, 2)
  totalTTC     Decimal @db.Decimal(10, 2)

  posSale PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([posSaleId])
  @@index([productId])
}
