# ─── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/artisastock_v2"

# ─── Auth JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-minimum-32-chars"
JWT_REFRESH_SECRET="change-me-in-production-minimum-32-chars-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_REMEMBER_EXPIRES_IN="30d"

# ─── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ArtisaStock"

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Resend (Email transactionnel) ─────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@artisastock.be"

# ─── UploadThing (Storage fichiers) ────────────────────────────────────────────
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# ─── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Monitoring (Sentry) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="..."
